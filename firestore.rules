rules_version = '2';

// MERGED rules: Wiggy Wash (role-based, location-scoped) + the existing
// golf app collections (courses / friendships / round_shares) that share this
// Firebase project. Remove the golf section only if that app no longer uses it.
service cloud.firestore {
  match /databases/{database}/documents {

    // ---- Helpers (Wiggy Wash role-based access) ----
    function signedIn() {
      return request.auth != null;
    }
    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function isPlatformAdmin() {
      return signedIn() && (userDoc().role == 'platformAdmin' || userDoc().role == 'superAdmin');
    }
    function isSuperAdmin() {
      return signedIn() && (userDoc().role == 'superAdmin' || userDoc().role == 'platformAdmin');
    }
    function isManagerOf(locationId) {
      return signedIn()
        && userDoc().role == 'manager'
        && userDoc().locationId == locationId;
    }
    function isCompanyManager(companyId) {
      return signedIn()
        && (userDoc().role == 'companyManager' || userDoc().role == 'manager')
        && userDoc().companyId == companyId;
    }
    function canManage(locationId) {
      return isManagerOf(locationId) || isSuperAdmin();
    }
    function canManageCompany(companyId) {
      return isPlatformAdmin() || isCompanyManager(companyId);
    }
    // A real (non-anonymous) account — i.e. a Google manager/super admin,
    // not an anonymous employee session.
    function isRealUser() {
      return signedIn()
        && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }
    function locationData(companyId, locationId) {
      return get(/databases/$(database)/documents/companies/$(companyId)/locations/$(locationId)).data;
    }
    // Missing accessStatus = active (legacy docs).
    function locationAllowsWrites(companyId, locationId) {
      let loc = locationData(companyId, locationId);
      return !('accessStatus' in loc)
        || loc.accessStatus == 'active'
        || loc.accessStatus == 'trial'
        || loc.accessStatus == 'comp';
    }
    function companyBillingKeys() {
      return ['purchasedSeats', 'stripeCustomerId', 'stripeSubscriptionId', 'billingStatus'];
    }
    function companyBillingUnchanged() {
      return !request.resource.data.diff(resource.data)
        .affectedKeys().hasAny(companyBillingKeys());
    }
    function locationCompChangeOk() {
      let prev = resource.data.get('accessStatus', 'active');
      let next = request.resource.data.get('accessStatus', prev);
      let touchesComp = prev == 'comp' || next == 'comp';
      return !touchesComp || isPlatformAdmin();
    }

    // ===== Wiggy Wash: company-scoped data =====
    match /companies/{companyId} {
      allow read: if signedIn();
      allow create: if isRealUser();
      allow update: if isPlatformAdmin()
        || (canManageCompany(companyId) && companyBillingUnchanged());
      allow delete: if isPlatformAdmin();

      match /locations/{locationId} {
        allow read: if signedIn();
        // Real users may create a location during self-service company signup
        // (role/companyId are written in the same batch; rules can't see them yet).
        allow create: if canManageCompany(companyId) || isRealUser();
        allow update: if (canManageCompany(companyId) || isPlatformAdmin())
          && locationCompChangeOk();
        allow delete: if isPlatformAdmin();

        match /submissions/{doc} {
          allow read: if signedIn();
          allow create, update: if signedIn()
            && locationAllowsWrites(companyId, locationId);
          allow delete: if canManageCompany(companyId);
        }
        match /workers/{doc} {
          allow read: if signedIn();
          allow write: if canManageCompany(companyId)
            && locationAllowsWrites(companyId, locationId);
        }
        match /config/{doc} {
          allow read: if signedIn();
          allow write: if canManageCompany(companyId)
            && locationAllowsWrites(companyId, locationId);
        }
        match /challenges/{doc} {
          allow read: if signedIn();
          allow write: if canManageCompany(companyId)
            && locationAllowsWrites(companyId, locationId);
        }
        match /requestPresets/{presetId} {
          allow read: if signedIn();
          allow create, update, delete: if canManageCompany(companyId)
            && locationAllowsWrites(companyId, locationId);
        }
        match /completionPresets/{presetId} {
          allow read: if signedIn();
          allow create, update, delete: if canManageCompany(companyId)
            && locationAllowsWrites(companyId, locationId);
        }
        match /staffRequests/{requestId} {
          allow read: if signedIn();

          allow create: if locationAllowsWrites(companyId, locationId)
            && (canManageCompany(companyId)
            || (signedIn()
                && request.resource.data.text is string
                && request.resource.data.text.size() > 0
                && request.resource.data.text.size() <= 120
                && request.resource.data.employeeName is string
                && request.resource.data.employeeName.size() > 0
                && (
                  (request.resource.data.status == 'pending'
                    && request.resource.data.source == 'employee_ask')
                  || (request.resource.data.status == 'assigned'
                    && request.resource.data.source == 'employee_personal')
                )));

          allow update: if locationAllowsWrites(companyId, locationId)
            && (canManageCompany(companyId)
            || (signedIn()
                && resource.data.status == 'assigned'
                && request.resource.data.status == 'awaitingReview'
                && resource.data.assigneeProfileKey is string
                && request.resource.data.assigneeProfileKey
                    == resource.data.assigneeProfileKey
                && request.resource.data.diff(resource.data).affectedKeys()
                    .hasOnly([
                      'status',
                      'completionNote',
                      'completionPresetId',
                      'completionPresetLabel',
                      'completedAt',
                      'completedByUid',
                      'revisionNote',
                      'revisionRequestedAt'
                    ])));

          allow delete: if canManageCompany(companyId)
            || (signedIn()
                && locationAllowsWrites(companyId, locationId)
                && resource.data.source == 'employee_personal'
                && resource.data.status == 'assigned'
                && resource.data.assigneeProfileKey is string);
        }
      }

      match /managerInvites/{inviteId} {
        allow read: if canManageCompany(companyId) || isRealUser();
        // Self-service company signup writes the creator's invite in the same
        // batch as role/companyId — rules can't see those yet, so allow a
        // real user to create an invite they claim for themselves.
        allow create: if canManageCompany(companyId)
          || (isRealUser()
              && request.resource.data.claimedUid == request.auth.uid
              && request.resource.data.invitedByUid == request.auth.uid);
        allow delete: if canManageCompany(companyId);
        allow update: if canManageCompany(companyId)
          || (isRealUser()
              && request.resource.data.diff(resource.data).affectedKeys()
                  .hasOnly(['claimedUid'])
              && request.resource.data.claimedUid == request.auth.uid);
      }
    }

    // ===== Wiggy Wash: location-scoped data (legacy — migration window) =====
    match /locations/{locationId} {
      allow read: if signedIn();
      // A manager creates their site during account creation (before a role is
      // assigned), so creation is gated on being a real signed-in account. A
      // super admin (which may be an anonymous, code-gated session) can also
      // create sites.
      allow create: if isRealUser() || isSuperAdmin();
      allow update: if canManage(locationId);
      allow delete: if isSuperAdmin();

      // Submitted scorecards: anyone signed in can read/create and update
      // (employees keep one running record per shift and Save updates it).
      // Deleting stays restricted to the location's manager / super admin.
      match /submissions/{doc} {
        allow read, create, update: if signedIn();
        allow delete: if canManage(locationId);
      }

      // Name roster employees pick from. Readable by any signed-in user
      // (employees are anonymous); writable only by the location's manager.
      match /workers/{doc} {
        allow read: if signedIn();
        allow write: if canManage(locationId);
      }

      // Config docs: prices (config/prices), settings such as see-all,
      // enabled sections + the team challenge (config/settings), and custom
      // line items / section order (config/items).
      match /config/{doc} {
        allow read: if signedIn();
        allow write: if canManage(locationId);
      }
    }

    // ===== Legacy Wiggy Wash (pre-multi-location) — kept for migration =====
    match /submissions/{id} {
      allow read, write: if request.auth != null;
    }
    match /workers/{id} {
      allow read, write: if request.auth != null;
    }
    match /config/{id} {
      allow read, write: if request.auth != null;
    }

    // ===== Golf app — shared project. Keep unless that app is retired. =====
    match /courses/{courseId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.holes is list;
      allow update, delete: if false;
    }

    // Friends: public profile (name + stats summary). Shared by both apps —
    // the Wiggy Wash client only ever merges its own fields (role, locationId)
    // into its own uid, so the two coexist.
    match /users/{uid} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == uid;
      allow update: if isPlatformAdmin()
        || (request.auth != null
            && request.auth.uid == uid
            && (
              !('role' in request.resource.data)
              || !('role' in resource.data)
              || request.resource.data.role == resource.data.role
              || request.resource.data.role == null
              || (
                request.resource.data.role == 'companyManager'
                && request.resource.data.companyId is string
                && isRealUser()
              )
            ));
      allow delete: if isPlatformAdmin();
    }

    // Friend links (QR scan creates these)
    match /friendships/{id} {
      allow read, delete: if request.auth != null
        && request.auth.uid in resource.data.uids;
      allow create: if request.auth != null
        && request.auth.uid in request.resource.data.uids
        && request.resource.data.uids.size() == 2;
      allow update: if request.auth != null
        && request.auth.uid in resource.data.uids;
    }

    // Shared rounds awaiting approval
    match /round_shares/{id} {
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.from_uid;
      allow read, delete: if request.auth != null
        && request.auth.uid == resource.data.to_uid;
    }
  }
}
